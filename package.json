{
  "name": "uni-extract",
  "version": "2.8.4",
  "description": "A modern high-performance media downloader and transcoder using Express, FFmpeg, and yt-dlp",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/install-ytdlp.js",
    "cookies:env": "node scripts/convert-cookies-to-env.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "server": "node server.js",
    "build": "npm run client:build",
    "sync:dist": "node scripts/sync-dist.js",
    "backend:install": "npm install --omit=dev",
    "backend:start": "node server.js",
    "backend:dev": "nodemon server.js",
    "frontend:install": "npm install --prefix client",
    "frontend:dev": "npm run dev --prefix client",
    "frontend:build": "npm run build --prefix client && npm run sync:dist",
    "fullstack:install": "npm install && npm run frontend:install",
    "fullstack:build": "npm run frontend:build",
    "fullstack:start": "npm run frontend:build && node server.js",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client && npm run sync:dist",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run server\" \"npm run client:dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:prod": "npm run client:build && cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "dist:win": "npm run client:build && electron-builder --win --publish never",
    "dist:win:release": "npm run client:build && electron-builder --win --publish always",
    "dist:win:x64": "npm run client:build && electron-builder --win --x64 --publish never",
    "dist:win:x64:release": "npm run client:build && electron-builder --win --x64 --publish always",
    "dist:win:arm64": "npm run client:build && electron-builder --win --arm64 --publish never",
    "dist:win:arm64:release": "npm run client:build && electron-builder --win --arm64 --publish always",
    "dist:win:all": "npm run client:build && electron-builder --win --x64 --arm64 --publish never",
    "dist:win:all:release": "npm run client:build && electron-builder --win --x64 --arm64 --publish always",
    "dist:linux": "npm run client:build && electron-builder --linux --publish never",
    "dist:linux:release": "npm run client:build && electron-builder --linux --publish always",
    "dist:mac": "npm run client:build && electron-builder --mac --publish never",
    "dist:mac:release": "npm run client:build && electron-builder --mac --publish always",
    "dist:all": "npm run client:build && electron-builder -mwl --publish never",
    "dist:all:release": "npm run client:build && electron-builder -mwl --publish always"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "uuid": "^13.0.0",
    "ytdlp-nodejs": "^3.4.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.0",
    "nodemon": "^3.1.14",
    "puppeteer-core": "^25.10.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.aryansdev.uniextract",
    "productName": "Uni Extract",
    "copyright": "Copyright © 2026 AryansDevStudios. All rights reserved.",
    "artifactName": "UniExtract-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "publish": {
      "provider": "github",
      "owner": "AryansDevStudios",
      "repo": "UniExtract"
    },
    "files": [
      "server.js",
      "electron/**",
      "client/dist/**",
      "public/**",
      "favicon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ytdlp-nodejs/**",
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "legalTrademarks": "Uni Extract™ is a trademark of AryansDevStudios",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "certificateFile": "certs/AryansDevStudios.pfx",
        "certificatePassword": "aryansdevstudios",
        "publisherName": "AryansDevStudios",
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "favicon.ico",
      "uninstallerIcon": "favicon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Uni Extract",
      "artifactName": "UniExtract-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "UniExtract-Portable-${version}-${arch}.${ext}",
      "unicode": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "category": "public.app-category.video",
      "artifactName": "UniExtract-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "category": "Video",
      "maintainer": "AryansDevStudios <aryansdevstudios@gmail.com>",
      "artifactName": "UniExtract-${version}-${arch}.${ext}"
    }
  },
  "keywords": [
    "youtube",
    "tiktok",
    "instagram",
    "snapchat",
    "downloader",
    "yt-dlp",
    "ffmpeg",
    "media-extractor"
  ],
  "author": "AryansDevStudios <aryansdevstudios@gmail.com> (https://github.com/AryansDevStudios)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryansDevStudios/UniExtract.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AryansDevStudios/UniExtract/issues"
  },
  "homepage": "https://github.com/AryansDevStudios/UniExtract#readme"
}
