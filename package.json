{
  "name": "universal-media-extractor",
  "version": "2.0.0",
  "description": "A multi-platform media downloader using Express, FFmpeg, and yt-dlp",
  "main": "server.js",
  "scripts": {
    "postinstall": "node scripts/install-ytdlp.js",
    "build": "npm run build --prefix client",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "uuid": "^13.0.0",
    "ytdlp-nodejs": "^3.4.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "puppeteer-core": "^25.10.0"
  },
  "keywords": [
    "youtube",
    "tiktok",
    "instagram",
    "snapchat",
    "downloader",
    "yt-dlp",
    "ffmpeg",
    "media-extractor"
  ],
  "author": "AryansDevStudios",
  "license": "MIT"
}
