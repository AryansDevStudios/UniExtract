# Uni Extract Environment Configuration

# Server Port (defaults to 3000)
PORT=3000

# Host Interface Binding
# - In local/PWA mode, defaults to 127.0.0.1 (not accessible outside local machine)
# - In cloud/Render deployments, defaults to 0.0.0.0
# HOST=127.0.0.1

# Cookie Upload & Deletion Password Protection
# Recommended for remote / Render servers to prevent unauthorized users from overriding cookies.
# If left empty, uploads are open and the server logs a red warning on startup.
COOKIE_PASSWORD=

# Cloud / Render Environment Cookies:
# Use either COOKIES_CONTENT (raw Netscape or JSON string) or COOKIES_BASE64 (base64-encoded cookies.txt).
# This allows deploying on Render or cloud VPS with working cookies without ever committing cookies.txt to GitHub!
# For local / PWA usage, the app automatically reads and preserves cookies.txt on disk.
# COOKIES_CONTENT=
# COOKIES_BASE64=

# Optional: Custom Cookies File Path (defaults to cookies.txt in root or Electron userData)
# COOKIES_PATH=./cookies.txt

# Optional: Temporary and Cache Directories
# TEMP_DIR=./temp
# CACHE_DIR=./cache

# Optional: FFmpeg Engine Configuration
# Modes:
#   auto   - (Default) Probes for host native FFmpeg first; falls back to bundled static build if not found.
#   native - Strictly uses native FFmpeg from host/container (enables GPU acceleration & dynamic codecs).
#   static - Forces bundled static FFmpeg (CPU-only processing fallback).
# FFMPEG_MODE=auto
# FFMPEG_PREFER_STATIC=false
# FFMPEG_PATH=/usr/bin/ffmpeg
